{
  "name": "backend-mini-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL-backed User and Post REST API",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:start": "node scripts/local-db.js start",
    "db:stop": "node scripts/local-db.js stop",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "node scripts/test-postgres.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/integration/api.test.js",
    "lint": "eslint .",
    "docs:check": "node scripts/check-openapi.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "supertest": "^7.2.2"
  }
}
