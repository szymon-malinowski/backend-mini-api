NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://mini_api:replace_me@127.0.0.1:5432/mini_api
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
# Comma-separated exact frontend origins; leave empty for same-origin only.
CORS_ORIGINS=
# Comma-separated trusted proxy IP addresses/CIDRs. Empty means no proxy trust.
TRUST_PROXY=
GLOBAL_RATE_LIMIT=100
AUTH_RATE_LIMIT=10
# Only for test:integration; must reference a separate disposable database.
# TEST_DATABASE_URL=postgresql://mini_api:replace_me@127.0.0.1:5432/mini_api_test
